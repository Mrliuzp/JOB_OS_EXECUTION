<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>{{ profile.name }} - {{ resume.target_title }}</title>
    <style>
      @page { size: A4; margin: 12mm; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        color: #1f2937;
        font-family: "Microsoft YaHei", "PingFang SC", "Noto Sans CJK SC", sans-serif;
        font-size: 10.5pt;
        line-height: 1.55;
      }
      h1 { margin: 0; font-size: 22pt; }
      h2 { margin: 16px 0 6px; border-bottom: 1px solid #d1d5db; font-size: 13pt; }
      h3 { margin: 8px 0 2px; font-size: 11pt; }
      p { margin: 4px 0; }
      ul { margin: 4px 0 0; padding-left: 20px; }
      li { break-inside: avoid; margin-bottom: 2px; }
      .meta { color: #4b5563; }
      .skills { display: flex; flex-wrap: wrap; gap: 6px; }
      .skill { border: 1px solid #d1d5db; border-radius: 4px; padding: 2px 7px; }
      .section, .experience { break-inside: avoid; }
      .muted { color: #6b7280; }
    </style>
  </head>
  <body>
    <header>
      <h1>{{ profile.name }}</h1>
      <p class="meta">
        {{ resume.target_title }}
        {% if profile.city %} · {{ profile.city }}{% endif %}
        {% if profile.email %} · {{ profile.email }}{% endif %}
        {% if profile.phone %} · {{ profile.phone }}{% endif %}
      </p>
    </header>

    <section class="section">
      <h2>个人简介</h2>
      <p>{{ resume.summary }}</p>
    </section>

    {% if resume.skills %}
    <section class="section">
      <h2>技术能力</h2>
      <div class="skills">
        {% for skill in resume.skills %}<span class="skill">{{ skill }}</span>{% endfor %}
      </div>
    </section>
    {% endif %}

    {% if resume.experiences %}
    <section class="section">
      <h2>工作与项目经历</h2>
      {% for item in resume.experiences %}
      <article class="experience">
        <h3>
          {{ item.company or item.role or "相关经历" }}
          {% if item.company and item.role %} · {{ item.role }}{% endif %}
        </h3>
        {% if item.period %}<p class="muted">{{ item.period }}</p>{% endif %}
        <ul>
          {% for bullet in item.bullets %}<li>{{ bullet.text }}</li>{% endfor %}
        </ul>
      </article>
      {% endfor %}
    </section>
    {% endif %}

    {% if resume.education %}
    <section class="section">
      <h2>教育经历</h2>
      {% for item in resume.education %}
      <article class="experience">
        <h3>{{ item.company or item.role or "教育经历" }}</h3>
        {% if item.period %}<p class="muted">{{ item.period }}</p>{% endif %}
        <ul>
          {% for bullet in item.bullets %}<li>{{ bullet.text }}</li>{% endfor %}
        </ul>
      </article>
      {% endfor %}
    </section>
    {% endif %}
  </body>
</html>
